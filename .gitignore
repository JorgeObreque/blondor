# Secretos y datos de producción (solo locales)
.env
agenda/config.prod.php
docker/db/init/*.sql.gz
*.csv
analisis_precios_*.md

# Runtime de la app
agenda/storage/logs/*
agenda/storage/sessions/*
agenda/storage/cache/*
!agenda/storage/**/index.html

node_modules/
agenda/storage/uploads/visits/*
!agenda/storage/uploads/visits/.htaccess
!agenda/storage/uploads/visits/index.html

# Server-only VAPID keys (never versioned or published)
.blondor-private/

# Log de errores de PHP que genera el hosting
agenda/error_log

# Galería de la portada: la genera scripts/galeria/ en jorgesv (no se versiona)
site/assets/galeria/
